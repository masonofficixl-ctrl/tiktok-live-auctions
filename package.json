{
  "name": "tiktok-live-auctions",
  "version": "1.0.0",
  "description": "TikTok Live Auction Platform with Real-time Bidding",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
